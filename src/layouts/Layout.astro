---
const {title='SMJ Research Atlas'}=Astro.props;
const base=import.meta.env.BASE_URL;
const nav=[['','總覽'],['landscape','研究地圖'],['papers','文獻搜尋'],['variables','變數字典'],['theories','理論導覽'],['gaps','研究缺口'],['quality','資料品質'],['about','使用方式']];
---
<!doctype html><html lang="zh-Hant"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Strategic Management Journal 文獻研究地圖與有證據可追溯的逐篇變數字典"/><title>{title} · SMJ Research Atlas</title></head><body><a class="skip" href="#main">跳至內容</a><aside><a class="brand" href={base}>SMJ<span>RESEARCH ATLAS</span></a><p class="aside-caption">策略研究的可追溯地圖</p><nav aria-label="主要導覽">{nav.map(([path,label])=><a href={`${base}${path}${path?'/':''}`} aria-current={Astro.url.pathname.replace(/\/$/,'')===`${base}${path}`.replace(/\/$/,'')?'page':undefined}>{label}</a>)}</nav><div class="aside-foot">1980 — PRESENT<br/>書目 × 理論 × 衡量證據</div></aside><div class="shell"><header><span>STRATEGIC MANAGEMENT JOURNAL</span><span class="badge">Evidence first</span></header><main id="main"><slot/></main><footer>SMJ Research Atlas · 獨立研究工具，非期刊官方網站。書目收錄與衡量驗證分開呈現。</footer></div></body></html>
<style is:global>
:root{font-family:Inter,'Segoe UI','Microsoft JhengHei',sans-serif;color:#203238;background:#f4f5f0;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:#216557;text-underline-offset:4px}aside{position:fixed;width:235px;background:#173e37;color:#e5eee7;height:100vh;padding:38px 25px;display:flex;flex-direction:column}.brand{font-family:Georgia,serif;font-size:48px;color:#fff;text-decoration:none;line-height:1}.brand span{display:block;font-family:inherit;font-size:12px;letter-spacing:2px;margin-top:15px}.aside-caption{font-size:12px;opacity:.7;margin:25px 0}nav{display:grid;gap:6px}nav a{color:#e1e9e3;text-decoration:none;padding:12px;border-radius:5px}nav a:hover,nav a[aria-current]{background:#31574c}.aside-foot{margin-top:auto;font-size:11px;line-height:2;letter-spacing:1px;opacity:.6}.shell{margin-left:235px}header{height:76px;border-bottom:1px solid #d9dfd5;display:flex;align-items:center;justify-content:space-between;padding:0 45px;font-size:11px;letter-spacing:1.8px}main{max-width:1400px;margin:auto;padding:45px}h1,h2,h3{font-weight:600;line-height:1.35}h1{font-size:38px;margin:12px 0 18px;letter-spacing:-1px}h2{font-size:22px}h3{font-size:17px}.eyebrow{color:#597566;letter-spacing:2px;font-size:11px;text-transform:uppercase}.lead{color:#63736d;max-width:780px;line-height:1.9}.badge{background:#e4ece1;color:#335a44;padding:5px 9px;font-size:11px;border-radius:3px;letter-spacing:.3px}.notice{padding:18px 22px;background:#edf0e5;border-left:3px solid #8c9d61;line-height:1.8;font-size:13px;margin:25px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px;margin:28px 0}.card{background:#fff;border:1px solid #dce3d8;padding:24px;border-radius:7px}.metric{font-family:Georgia,serif;font-size:44px;margin:14px 0;color:#194c3e}.muted{color:#687971;font-size:13px;line-height:1.8}.toolbar{display:flex;flex-wrap:wrap;gap:12px;margin:25px 0}input,select,button{font:inherit;padding:11px;border:1px solid #b7c7ba;border-radius:4px;background:#fff;color:#203b30}input{flex:1;min-width:200px}button{cursor:pointer;background:#1d5546;color:white}button:disabled{opacity:.5}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #bd883c;outline-offset:3px}.paper{background:white;border-top:1px solid #dae2d6;padding:24px 20px}.paper h2{margin:10px 0;font-size:19px}.paper a{text-decoration:none}.empty{border:1px dashed #a5b7a4;border-radius:6px;padding:40px;color:#5c6e60;line-height:1.9}.bar{display:flex;align-items:center;gap:12px;margin:10px 0;font-size:12px}.bar i{display:block;background:#46816c;height:14px;min-width:2px}.bar span{width:42px}.bar b{font-weight:400}table{border-collapse:collapse;width:100%;font-size:13px}td,th{text-align:left;padding:14px;border-bottom:1px solid #dae1d5;vertical-align:top}code{overflow-wrap:anywhere}footer{padding:26px 45px;color:#708071;font-size:11px;border-top:1px solid #d9dfd5}.skip{position:absolute;left:260px;top:-100px}.skip:focus{top:8px;z-index:10;background:white;padding:12px}.section-head{display:flex;justify-content:space-between;align-items:center;margin-top:36px}.pill{display:inline-block;font-size:11px;color:#57715e;padding:3px 7px;background:#edf2e9;margin-right:6px}.detail{overflow-wrap:anywhere;line-height:1.9}pre{white-space:pre-wrap} @media(max-width:800px){aside{position:static;width:100%;height:auto;padding:22px}.brand{font-size:30px}.brand span{display:inline;margin-left:15px}nav{display:flex;overflow:auto;margin-top:10px}nav a{white-space:nowrap;font-size:13px}.aside-caption,.aside-foot{display:none}.shell{margin:0}header{padding:0 22px;height:55px;font-size:9px}main{padding:26px 22px}h1{font-size:29px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.card{padding:17px}.metric{font-size:34px}footer{padding:22px}}
</style>
