---
import Layout from '../layouts/Layout.astro';
---
<Layout title="文獻搜尋"><div class="eyebrow">Explore the corpus</div><h1>文獻搜尋</h1><p class="lead">Atlas 四層分類參照 SMS Interest Groups，非 SMJ 官方 taxonomy。Theory 是獨立維度；預設僅依人工確認的分類篩選，演算法建議須另外選取。</p><p class="muted">Domain／Research Topic／Construct／Theory 可按 Ctrl／⌘ 多選（同維度 OR、跨維度 AND）。不選表示不限制該維度。Theory 不插入四層階層。</p><button id="clear-taxonomy">清除分類選項</button><div class="toolbar"><input id="search" aria-label="搜尋標題、作者或 DOI" placeholder="標題、作者或 DOI…"/><select id="year" aria-label="年份"><option value="">全部年份</option></select><label>Domain · L1<select id="domain" multiple size="3" aria-label="Domain 多選"></select></label><label>Research Topic · L2<select id="topic" multiple size="3" aria-label="Research Topic 多選"></select></label><label>Construct · L3<select id="construct" multiple size="3" aria-label="Construct 多選"></select></label><label>Theory · 獨立維度<select id="theory" multiple size="3" aria-label="Theory 多選"></select></label><select id="review-mode" aria-label="分類審核範圍"><option value="approved">僅人工確認分類</option><option value="both">含待審演算法建議</option><option value="suggested">僅待審建議</option></select><select id="method" aria-label="方法"><option value="">全部方法</option></select><select id="status" aria-label="查核程度"><option value="">全部查核程度</option><option>metadata_only</option><option>abstract_screened</option><option>fulltext_screened</option><option>measurement_verified</option><option>human_reviewed</option></select><select id="oa" aria-label="開放取用"><option value="">全部取用狀態</option><option value="yes">有 OA 連結</option></select></div><div class="toolbar"><span id="count" role="status">載入資料…</span><button id="json">匯出 JSON</button><button id="csv">匯出 CSV</button></div><div id="results"></div><div class="toolbar"><button id="prev">上一頁</button><span id="page" aria-live="polite"></span><button id="next">下一頁</button></div></Layout>
<script>
const base=import.meta.env.BASE_URL; let rows:any[]=[],filtered:any[]=[],page=0;const size=25;
const el=(id:string)=>document.getElementById(id)!;const value=(id:string)=>(el(id) as HTMLInputElement).value;
const ids=['search','year','domain','theory','method','status','oa','topic','construct','review-mode'];
function matchesTaxonomy(p:any,id:string,level:string){const wanted=Array.from((el(id) as HTMLSelectElement).selectedOptions).map(o=>o.value);const mode=value('review-mode');const statuses=mode==='both'?['approved','suggested']:[mode];return !wanted.length||wanted.some(t=>statuses.some(s=>(p.taxonomy_tags?.[s]?.[level]||[]).includes(t)))}
el('clear-taxonomy').onclick=()=>{for(const id of ['domain','topic','construct','theory'])for(const o of (el(id) as HTMLSelectElement).options)o.selected=false;page=0;render()};
function render(){const q=value('search').toLowerCase().trim();filtered=rows.filter(p=>(!q||[p.title,p.doi,...p.authors].join(' ').toLowerCase().includes(q))&&(!value('year')||String(p.publication_year)===value('year'))&&matchesTaxonomy(p,'domain','domain')&&matchesTaxonomy(p,'topic','research_topic')&&matchesTaxonomy(p,'construct','construct')&&matchesTaxonomy(p,'theory','theory')&&(!value('method')||p.method_tags.includes(value('method')))&&(!value('status')||p.verification_status===value('status'))&&(!value('oa')||p.oa_url));el('count').textContent=`${filtered.length} 篇文獻 · 分類：${value('review-mode')==='approved'?'僅人工確認':'含待審建議，非衡量驗證'}`;el('results').replaceChildren();for(const p of filtered.slice(page*size,(page+1)*size)){const article=document.createElement('article');article.className='paper';const meta=document.createElement('span');meta.className='muted';meta.textContent=`${p.publication_year} · ${p.verification_status}`;const h=document.createElement('h2');const a=document.createElement('a');a.href=base+'paper/?id='+encodeURIComponent(p.paper_id);a.textContent=p.title;h.append(a);const authors=document.createElement('p');authors.className='muted';authors.textContent=p.authors.join(', ');const doi=document.createElement('a');doi.href='https://doi.org/'+p.doi;doi.textContent=p.doi;article.append(meta,h,authors,doi);el('results').append(article)}if(!filtered.length){const p=document.createElement('p');p.className='empty';p.textContent='目前沒有符合條件的紀錄。未分類不等於不屬於該理論或領域。';el('results').append(p)}el('page').textContent=`${page+1} / ${Math.max(1,Math.ceil(filtered.length/size))}`;(el('prev') as HTMLButtonElement).disabled=page===0;(el('next') as HTMLButtonElement).disabled=(page+1)*size>=filtered.length}
ids.forEach(id=>el(id).addEventListener('input',()=>{page=0;render()}));el('prev').onclick=()=>{page--;render()};el('next').onclick=()=>{page++;render()};
function download(type:string){const quote=(v:any)=>'"'+(typeof v==='object'&&v!==null?JSON.stringify(v):String(v??'')).replaceAll('"','""')+'"';const keys=['paper_id','doi','title','authors','publication_year','verification_status','metadata_provenance','taxonomy_version','taxonomy_tags','legacy_domain_codes'];const data=type==='json'?JSON.stringify(filtered,null,2):'\ufeff'+[keys.join(','),...filtered.map(p=>keys.map(k=>quote(k==='authors'?p[k].join('; '):p[k])).join(','))].join('\r\n');const url=URL.createObjectURL(new Blob([data],{type:type==='json'?'application/json':'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='smj-papers.'+type;a.click();URL.revokeObjectURL(url)}el('json').onclick=()=>download('json');el('csv').onclick=()=>download('csv');
try{const res=await fetch(base+'data/papers.json');if(!res.ok)throw Error('HTTP '+res.status);rows=(await res.json()).sort((a:any,b:any)=>b.publication_year-a.publication_year);for(const [id,key] of [['year','publication_year'],['domain','domain_codes'],['theory','theory_tags'],['method','method_tags']]){const values=[...new Set(rows.flatMap(p=>Array.isArray(p[key])?p[key]:[p[key]]))].sort();for(const v of values){const o=document.createElement('option');o.value=String(v);o.textContent=String(v);el(id).append(o)}}const taxonomy=await (await fetch(base+'data/taxonomy.json')).json();for(const [id,level] of [['domain','domain'],['topic','research_topic'],['construct','construct'],['theory','theory']]){el(id).replaceChildren();for(const d of taxonomy.nodes.filter((n:any)=>n.level===level)){const o=document.createElement('option');o.value=d.id;o.textContent=d.label_zh+' / '+d.label_en;el(id).append(o)}}const params=new URLSearchParams(location.search);for(const id of ['domain','topic','construct','theory']){const requested=params.getAll(id);for(const o of (el(id) as HTMLSelectElement).options)o.selected=requested.includes(o.value)}if(['both','suggested'].includes(params.get('mode')||''))(el('review-mode') as HTMLSelectElement).value=params.get('mode')!;render()}catch(e){el('count').textContent='資料載入失敗，請重新整理。';console.error(e)}
</script>

<style>label{display:grid;gap:6px;max-width:100%;font-size:12px}select[multiple]{width:320px;max-width:100%;font-size:12px}</style>
