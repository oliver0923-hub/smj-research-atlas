---
import Layout from '../layouts/Layout.astro';
---
<Layout title="文獻搜尋"><div class="eyebrow">Explore the corpus</div><h1>文獻搜尋</h1><p class="lead">搜尋實際收錄的 SMJ 書目；領域與理論尚未分類的紀錄不會被視為已確認。</p><div class="toolbar"><input id="search" aria-label="搜尋標題、作者或 DOI" placeholder="標題、作者或 DOI…"/><select id="year" aria-label="年份"><option value="">全部年份</option></select><select id="domain" aria-label="研究領域"><option value="">全部領域</option></select><select id="theory" aria-label="理論"><option value="">全部理論</option></select><select id="method" aria-label="方法"><option value="">全部方法</option></select><select id="status" aria-label="查核程度"><option value="">全部查核程度</option><option>metadata_only</option><option>abstract_screened</option><option>fulltext_screened</option><option>measurement_verified</option><option>human_reviewed</option></select><select id="oa" aria-label="開放取用"><option value="">全部取用狀態</option><option value="yes">有 OA 連結</option></select></div><div class="toolbar"><span id="count" role="status">載入資料…</span><button id="json">匯出 JSON</button><button id="csv">匯出 CSV</button></div><div id="results"></div><div class="toolbar"><button id="prev">上一頁</button><span id="page" aria-live="polite"></span><button id="next">下一頁</button></div></Layout>
<script>
const base=import.meta.env.BASE_URL; let rows:any[]=[],filtered:any[]=[],page=0;const size=25;
const el=(id:string)=>document.getElementById(id)!;const value=(id:string)=>(el(id) as HTMLInputElement).value;
const ids=['search','year','domain','theory','method','status','oa'];
function render(){const q=value('search').toLowerCase().trim();filtered=rows.filter(p=>(!q||[p.title,p.doi,...p.authors].join(' ').toLowerCase().includes(q))&&(!value('year')||String(p.publication_year)===value('year'))&&(!value('domain')||p.domain_codes.includes(value('domain')))&&(!value('theory')||p.theory_tags.includes(value('theory')))&&(!value('method')||p.method_tags.includes(value('method')))&&(!value('status')||p.verification_status===value('status'))&&(!value('oa')||p.oa_url));el('count').textContent=`${filtered.length} 篇文獻`;el('results').replaceChildren();for(const p of filtered.slice(page*size,(page+1)*size)){const article=document.createElement('article');article.className='paper';const meta=document.createElement('span');meta.className='muted';meta.textContent=`${p.publication_year} · ${p.verification_status}`;const h=document.createElement('h2');const a=document.createElement('a');a.href=base+'paper/?id='+encodeURIComponent(p.paper_id);a.textContent=p.title;h.append(a);const authors=document.createElement('p');authors.className='muted';authors.textContent=p.authors.join(', ');const doi=document.createElement('a');doi.href='https://doi.org/'+p.doi;doi.textContent=p.doi;article.append(meta,h,authors,doi);el('results').append(article)}if(!filtered.length){const p=document.createElement('p');p.className='empty';p.textContent='目前沒有符合條件的紀錄。未分類不等於不屬於該理論或領域。';el('results').append(p)}el('page').textContent=`${page+1} / ${Math.max(1,Math.ceil(filtered.length/size))}`;(el('prev') as HTMLButtonElement).disabled=page===0;(el('next') as HTMLButtonElement).disabled=(page+1)*size>=filtered.length}
ids.forEach(id=>el(id).addEventListener('input',()=>{page=0;render()}));el('prev').onclick=()=>{page--;render()};el('next').onclick=()=>{page++;render()};
function download(type:string){const quote=(v:any)=>'"'+(typeof v==='object'&&v!==null?JSON.stringify(v):String(v??'')).replaceAll('"','""')+'"';const keys=['paper_id','doi','title','authors','publication_year','verification_status','metadata_provenance'];const data=type==='json'?JSON.stringify(filtered,null,2):'\ufeff'+[keys.join(','),...filtered.map(p=>keys.map(k=>quote(k==='authors'?p[k].join('; '):p[k])).join(','))].join('\r\n');const url=URL.createObjectURL(new Blob([data],{type:type==='json'?'application/json':'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='smj-papers.'+type;a.click();URL.revokeObjectURL(url)}el('json').onclick=()=>download('json');el('csv').onclick=()=>download('csv');
try{const res=await fetch(base+'data/papers.json');if(!res.ok)throw Error('HTTP '+res.status);rows=(await res.json()).sort((a:any,b:any)=>b.publication_year-a.publication_year);for(const [id,key] of [['year','publication_year'],['domain','domain_codes'],['theory','theory_tags'],['method','method_tags']]){const values=[...new Set(rows.flatMap(p=>Array.isArray(p[key])?p[key]:[p[key]]))].sort();for(const v of values){const o=document.createElement('option');o.value=String(v);o.textContent=String(v);el(id).append(o)}}const ontology=await (await fetch(base+'data/ontology.json')).json();for(const d of ontology){if(!Array.from((el('domain') as HTMLSelectElement).options).some(o=>o.value===d.id)){const o=document.createElement('option');o.value=d.id;o.textContent=d.label_zh+' ('+d.id+')';el('domain').append(o)}}const domain=new URLSearchParams(location.search).get('domain');if(domain)(el('domain') as HTMLSelectElement).value=domain;render()}catch(e){el('count').textContent='資料載入失敗，請重新整理。';console.error(e)}
</script>
