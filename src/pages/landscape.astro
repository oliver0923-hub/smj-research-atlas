---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
const taxonomy=JSON.parse(fs.readFileSync('public/data/taxonomy.json','utf8'));
const papers=JSON.parse(fs.readFileSync('public/data/papers.json','utf8'));
const domains=taxonomy.nodes.filter(n=>n.level==='domain');
const children=(id,level)=>taxonomy.nodes.filter(n=>n.level===level&&n.parent_ids.includes(id));
const count=(id,status)=>papers.filter(p=>p.taxonomy_tags[status].domain.includes(id)).length;
const base=import.meta.env.BASE_URL;
const originLabel={official_academic_organization:'官方學術組織名稱參照',custom_research:'自訂研究分類',algorithmic:'演算法辨識分類'};
const sourceList=(n)=>taxonomy.sources.filter(s=>n.source_ids.includes(s.id));
---
<Layout title="研究分類地圖"><div class="eyebrow">Research taxonomy · v{taxonomy.version}</div><h1>研究領域、主題與衡量的四層地圖</h1><div class="notice"><strong>這是 Atlas 編製的研究分類，非 SMJ 官方 taxonomy。</strong> Level 1 參照 SMS Interest Groups；英文名稱來自 SMS，中文譯名、下層分類與跨層對應均由 Atlas 編製。AOM STR Domain Statement 用於範圍檢查，不代表組織認可。</div><p class="lead">Domain → Research Topic → Construct → Operational Variable。Theory 為獨立、多重標記維度。官方組織名稱的來源可核對，不表示某篇論文的分類已獲官方或人工確認。</p><p><a href={`${base}taxonomy-methodology/`}>分類方法、正式參考文獻與版本紀錄</a> · <a href={`${base}taxonomy-review/`}>人工審核與新興主題候選</a> · <a href={`${base}theories/`}>獨立理論維度</a></p><p class="muted">同篇文獻可跨多個領域與主題，以下數量不可相加當成總篇數。演算法候選不計入人工確認數量。下層工作詞彙仍待研究者審核。</p><div class="grid">{domains.map(d=><article class="card"><span class="badge">L1 · {originLabel[d.origin]}</span><h2>{d.label_zh}</h2><p>{d.official_label_en||d.label_en}</p><p class="muted">中文譯名與層級編排：Atlas 自訂</p><p><a href={`${base}papers/?domain=${d.id}`}>人工確認 {count(d.id,'approved')} 篇</a> · <a href={`${base}papers/?domain=${d.id}&mode=both`}>演算法候選 {count(d.id,'suggested')} 篇</a></p><details><summary>查看 L2 主題 → L3 構念 → L4 衡量</summary>{children(d.id,'research_topic').map(t=><section><h3><a href={`${base}papers/?topic=${t.id}&mode=both`}>{t.label_zh}</a></h3><p class="muted">L2 · {t.label_en} · {originLabel[t.origin]} · {t.review_status}<br/>方法：{t.method}<br/>來源：{sourceList(t).map(s=><a href={s.url}>{s.id} </a>)}</p>{children(t.id,'construct').map(c=><div class="notice"><strong>L3 · {c.label_zh} · {originLabel[c.origin]} · {c.review_status}</strong><p class="muted">{c.label_en} · {c.method}<br/>來源：{sourceList(c).map(s=><a href={s.url}>{s.id} </a>)}<br/>詞彙不是已擷取的論文主張</p>{children(c.id,'operational_variable').length?children(c.id,'operational_variable').map(v=><a href={`${base}paper/?id=${encodeURIComponent(v.paper_id)}`}>L4 · {v.label_en}</a>):<p class="muted">L4：尚無附逐篇原始證據的 Operational Variable。</p>}</div>)}{!children(t.id,'construct').length&&<p class="muted">L3／L4 尚待具來源的逐篇審閱。</p>}</section>)}</details><p class="muted">來源：{sourceList(d).map(s=><a href={s.url}>{s.title} </a>)}<br/>方法：{d.method}<br/>版本：{d.version}</p></article>)}</div></Layout>
