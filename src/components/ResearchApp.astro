---
const {kind}=Astro.props;
---
<div id="research-app" data-kind={kind}><p role="status">正在載入來源資料…</p></div>
<script>import '../scripts/research-app';</script>
<style is:global>.data-table{overflow:auto;max-width:100%}.data-table table{min-width:650px}.controls{display:flex;gap:12px;flex-wrap:wrap;margin:22px 0}.controls label{display:grid;gap:6px;font-size:12px;max-width:100%}.controls select{max-width:100%}.chart{width:100%;height:auto;background:#fff;border:1px solid #dce3d8;border-radius:7px}.evidence{background:#edf1e6;padding:14px;border-left:3px solid #4f7c60;line-height:1.9}.record{margin:18px 0;padding:22px;background:white;border:1px solid #dce3d8;border-radius:6px;overflow-wrap:anywhere}h1{overflow-wrap:anywhere}.status-line{font-size:12px;color:#5b7165;line-height:1.9}.record dl{display:grid;grid-template-columns:130px 1fr;gap:9px;font-size:13px}.record dt{font-weight:600}.record dd{margin:0}.chart text{font-family:inherit;fill:#203238}.tiny{font-size:11px;color:#617264}summary{cursor:pointer;padding:8px}button[aria-pressed=true]{outline:3px solid #b98b44}#research-app a{overflow-wrap:anywhere}@media(max-width:600px){.record dl{grid-template-columns:1fr}.controls input{min-width:0;max-width:100%}.controls{display:grid;grid-template-columns:1fr 1fr}.controls label{min-width:0}.controls input,.controls select{width:100%;min-width:0}.record{padding:16px}}</style>
