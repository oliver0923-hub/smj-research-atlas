      "enum": [
        "domain",
        "research_topic",
        "construct",
        "operational_variable",
        "theory"
      ],
      "title": "Level",
      "type": "string"
    },
    "label_zh": {
      "title": "Label Zh",
      "type": "string"
    },
    "label_en": {
      "title": "Label En",
      "type": "string"
    },
    "parent_ids": {
      "items": {
        "type": "string"
      },
      "title": "Parent Ids",
      "type": "array"
    },
    "origin": {
